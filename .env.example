# Wintergreen x402 Content Broker — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Merchant wallet that receives x402 payments (required)
X402_PAY_TO=0x0000000000000000000000000000000000000000

# Public URL of this broker (used in invoices / .well-known/x402)
X402_PUBLIC_URL=http://localhost:8000

# Coinbase Developer Platform facilitator credentials (optional)
# With CDP: per-endpoint JWT auth, on-chain settlement via facilitator.
# Without CDP: graceful fallback to free mode.
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=
X402_USE_CDP=true

# Network for on-chain settlement (e.g. base, sepolia)
X402_NETWORK=base
